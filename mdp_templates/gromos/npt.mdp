; ============================================================
; NPT 平衡 —— GROMOS 54A7 体系；从 NVT 的 .cpt 续跑
; ============================================================
integrator      = md
dt              = 0.002
nsteps          = 500000      ; 1 ns

nstxout             = 0
nstvout             = 0
nstfout             = 0
nstenergy           = 500
nstlog              = 500
nstxout-compressed  = 1000

; --- 非键设置 (与 EM/NVT 一致) ---
cutoff-scheme   = Verlet
nstlist         = 10
coulombtype     = reaction-field
epsilon-rf      = 65
rcoulomb        = 1.4
rvdw            = 1.4
vdwtype         = cutoff
vdw-modifier    = Potential-shift
DispCorr        = no

; --- 约束 ---
constraints             = all-bonds
constraint-algorithm    = lincs
lincs-order             = 4
lincs-iter              = 1

; --- 控温 ---
tcoupl          = V-rescale
tc-grps         = Protein_LIG   Water_and_ions
tau-t           = 0.1           0.1
ref-t           = 300           300

; --- 控压 ---
; C-rescale 冷启动稳、收敛快；GROMOS 社区常用 Parrinello-Rahman，
; 需要严格 NPT 涨落时再换（tau-p >= 2）。
pcoupl              = C-rescale
pcoupltype          = isotropic
tau-p               = 2.0
ref-p               = 1.013
compressibility     = 4.5e-5

gen-vel             = no
continuation        = yes

define              = -DPOSRES
refcoord-scaling    = com
